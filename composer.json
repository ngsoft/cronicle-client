{
  "name": "ngsoft/cronicle-tasks-client",
  "description": "PHP HTTP client for the Cronicle JSON REST API, with typed DTOs and OpenAPI schema",
  "type": "library",
  "keywords": [
    "cronicle",
    "client",
    "rest",
    "api",
    "scheduler",
    "http",
    "dto"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "Aymeric Anger",
      "role": "Developer",
      "homepage": "https://github.com/ngsoft"
    }
  ],
  "homepage": "https://github.com/ngsoft/cronicle-client",
  "support": {
    "issues": "https://github.com/ngsoft/cronicle-client/issues",
    "source": "https://github.com/ngsoft/cronicle-client"
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": {
    "optimize-autoloader": false,
    "sort-packages": true,
    "process-timeout": 0,
    "platform-check": false
  },
  "autoload": {
    "files": ["lib/functions.php"],
    "psr-4": {
      "NGSOFT\\": "src/"
    }
  },
  "require": {
    "php": ">=8.2",
    "ext-curl": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "symfony/dotenv": "^7"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^2|^3",
    "symfony/var-dumper": "^7"
  },
  "suggest": {
    "symfony/var-dumper": "Needed by examples/client-test.php (dump())"
  },
  "scripts": {
    "cs:fix": [
      "Composer\\Config::disableProcessTimeout",
      "php8.2 vendor/bin/php-cs-fixer fix src"
    ]
  }
}
