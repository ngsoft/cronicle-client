{
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": {
    "optimize-autoloader": false,
    "sort-packages": true,
    "process-timeout": 0,
    "platform-check": false
  },
  "autoload": {
    "files": ["lib/libs-no-sql-php82.php"],
    "psr-4": {
      "": "src/"
    }
  },
  "require": {
    "php": ">=8.2",
    "symfony/dotenv": "^7"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^2|^3"
  },
  "script": {
    "cs:fix": [
      "Composer\\Config::disableProcessTimeout",
      "php8.2 vendor/bin/php-cs-fixer fix src"
    ]
  }
}
